# ═══════════════════════════════════════════════════════════════
#  RTX EARN — Quotex Data Service — Environment Variables Template
#
#  এই ফাইলটার নাম .env রেখে (এই .example বাদ দিয়ে) আসল মান বসাও।
#  Render-এ deploy করার সময় এই একই ভ্যারিয়েবলগুলো Render Dashboard →
#  Environment ট্যাবে বসাতে হবে (Render .env ফাইল পড়ে না, ড্যাশবোর্ড
#  থেকেই সেট করতে হয়)।
#
#  ⚠️ .env ফাইলটা কখনো GitHub-এ push করবে না — .gitignore-এ যোগ করো।
# ═══════════════════════════════════════════════════════════════

# ── Quotex লগইন তথ্য ─────────────────────────────────────────────
# এটা এই ডেটা-সার্ভিসের নিজস্ব Quotex একাউন্ট (ইউজারদের একাউন্ট না —
# শুধু market data পড়ার জন্য ব্যবহার হবে)
QUOTEX_EMAIL=your_quotex_email@example.com
QUOTEX_PASSWORD=your_quotex_password

# ── একাউন্ট মোড ───────────────────────────────────────────────────
# PRACTICE = ডেমো একাউন্ট (টেস্টিং-এর জন্য নিরাপদ, সুপারিশকৃত)
# REAL     = আসল একাউন্ট
QUOTEX_ACCOUNT_MODE=PRACTICE

# ── এই সার্ভিসকে সুরক্ষিত রাখার সিক্রেট কী ────────────────────────
# এখানে একটা লম্বা র‍্যান্ডম স্ট্রিং বসাও (যেমন: openssl rand -hex 32
# দিয়ে জেনারেট করতে পারো, অথবা যেকোনো পাসওয়ার্ড জেনারেটর ব্যবহার করো)।
# এই একই মান পরে Node.js backend-এর .env এও বসাতে হবে (SERVICE_API_KEY
# নামে) — দুই সার্ভিসের মধ্যে যোগাযোগ যাচাই করার জন্য।
SERVICE_API_KEY=এখানে_একটা_শক্তিশালী_র‍্যান্ডম_স্ট্রিং_বসাও

# ── পোর্ট (Render নিজে থেকে PORT ভ্যারিয়েবল সেট করে দেয়, তাই সাধারণত
#    এটা ম্যানুয়ালি ছুঁতে হয় না — শুধু লোকাল টেস্টিং-এর জন্য) ──────
PORT=8000
