# ═══════════════════════════════════════════════════════════════
#  RTX EARN — Quotex Data Service — .gitignore
# ═══════════════════════════════════════════════════════════════

# ── এনভায়রনমেন্ট সিক্রেট — সবচেয়ে গুরুত্বপূর্ণ, কখনো push হবে না ───
.env
.env.local
*.env
!.env.example

# ── Python runtime ফাইল ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ── ভার্চুয়াল এনভায়রনমেন্ট ───────────────────────────────────────
venv/
env/
ENV/
.venv/

# ── pyquotex সেশন/কনফিগ ফাইল (থাকলে, লগইন সেশন টোকেন সিক্রেট) ─────
sessions/
*.session
session.json
config.json

# ── playwright ব্রাউজার ডাউনলোড ক্যাশ (রিপোতে রাখার দরকার নেই) ─────
.playwright/
ms-playwright/

# ── লগ ফাইল ──────────────────────────────────────────────────────
*.log
logs/

# ── OS/এডিটর জাংক ────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Build/dist artifacts ─────────────────────────────────────────
build/
dist/
*.egg-info/
