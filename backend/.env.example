# ═══════════════════════════════════════════════════════════════
#  RTX EARN — Node.js Backend — Environment Variables Template
#
#  এই ফাইলের নাম .env রেখে (এই .example বাদ দিয়ে) আসল মান বসাও।
#  Render-এ deploy করার সময় এই ভ্যারিয়েবলগুলো Render Dashboard →
#  Environment ট্যাবে বসাতে হবে।
#
#  ⚠️ .env ফাইল কখনো GitHub-এ push করো না।
# ═══════════════════════════════════════════════════════════════

# ── Telegram Bot ──────────────────────────────────────────────
# @BotFather থেকে /newbot করে বট বানিয়ে টোকেন নাও
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# তোমার নিজের Telegram user ID (পেমেন্ট নোটিফিকেশন এখানে আসবে)।
# নিজের ID জানতে @userinfobot কে টেলিগ্রামে মেসেজ দাও
TELEGRAM_ADMIN_CHAT_ID=123456789

# Mini App-এর টেলিগ্রাম লিংক (BotFather দিয়ে Web App সেটআপ করার পর পাবে)
MINI_APP_URL=https://t.me/your_bot_username/app

# ── Firebase Admin SDK ────────────────────────────────────────
# Firebase Console → Project Settings → Service Accounts →
# "Generate new private key" → ডাউনলোড হওয়া JSON ফাইলের পুরো
# কনটেন্ট এক লাইনে (line breaks ছাড়া) এখানে বসাও।
# টিপ: JSON ফাইলটাকে online এক-লাইন-JSON মিনিফায়ার দিয়ে কমপ্যাক্ট
# করে নিতে পারো, তারপর পুরোটা কপি করে এখানে পেস্ট করো।
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...", ...}

# ── Python Quotex Data Service ────────────────────────────────
# quotex-service Render-এ deploy করার পর যে URL পাবে সেটা এখানে বসাও
QUOTEX_SERVICE_URL=https://rtx-earn-quotex-service.onrender.com

# quotex-service/.env এ যে SERVICE_API_KEY বসিয়েছিলে, ঠিক একই মান
# এখানেও বসাতে হবে (দুই সার্ভিসের মধ্যে হ্যান্ডশেক ভেরিফিকেশন)
SERVICE_API_KEY=একই_র‍্যান্ডম_স্ট্রিং_যা_quotex_service_এ_দিয়েছো

# ── পোর্ট (Render নিজে থেকে PORT সেট করে দেয়, লোকাল টেস্টিং-এর জন্য) ──
PORT=3000
