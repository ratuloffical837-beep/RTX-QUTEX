# ═══════════════════════════════════════════════════════════════
#  RTX EARN — Mini App — Environment Variables Template
#
#  এই ফাইলের নাম .env রেখে (এই .example বাদ দিয়ে) আসল মান বসাও।
#
#  ⚠️ গুরুত্বপূর্ণ: Vite-তে শুধু VITE_ প্রিফিক্স দেওয়া ভ্যারিয়েবলই
#  ব্রাউজারে এক্সপোজ হয় (import.meta.env দিয়ে অ্যাক্সেস করা যায়)।
#  প্রিফিক্স ছাড়া ভ্যারিয়েবল বসালে কোড থেকে undefined আসবে।
#
#  Render Static Site-এ deploy করার সময় এই ভ্যারিয়েবলগুলো Render
#  Dashboard → Environment ট্যাবে বসাতে হবে (build time-এ ব্যবহার হয়,
#  কারণ Vite build করার সময়ই এগুলো bundle-এ বসিয়ে দেয়)।
# ═══════════════════════════════════════════════════════════════

# ── Firebase Client Config ────────────────────────────────────
# Firebase Console → Project Settings → General → "Your apps" →
# Web app আইকনে ক্লিক করলে এই ৬টা মান পাবে
VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ── Node.js Backend URL ────────────────────────────────────────
# backend/ Render-এ deploy করার পর যে URL পাবে সেটা এখানে বসাও
VITE_BACKEND_URL=https://rtx-earn-backend.onrender.com
